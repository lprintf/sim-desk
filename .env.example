# Host-side paths. Relative paths are resolved from compose.yaml.
SIM_DESK_WORKSPACE=./workspace
SIM_DESK_OUTPUT=./data/output

# Required. Generate a long random value before starting the stack.
SIM_DESK_AUTH_KEY=replace-with-a-long-random-value

# Codex authentication. Choose one mode:
# 1. ChatGPT login: leave OPENAI_API_KEY empty, then run
#      docker compose run --rm runtime codex login
# 2. API key: set OPENAI_API_KEY. Codex reads it directly from the runtime
#    environment, so no interactive login is required. Run `codex logout`
#    before switching modes if the persistent volume already has a login.
OPENAI_API_KEY=

# Optional OpenAI-compatible API endpoint, including the API version path.
# Leave empty for the official OpenAI endpoint. Example:
# OPENAI_BASE_URL=https://gateway.example.com/v1
OPENAI_BASE_URL=

# Optional Codex defaults. CODEX_MODEL is also applied to direct `codex`
# commands inside the container. Leave it empty to use the Codex default.
CODEX_MODEL=gpt-5.6-sol
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=on-request
CODEX_ACTIVITY_STALE_MS=600000

# Optional provider credentials. Keep real values only in .env or secrets.
MINIMAX_API_KEY=

# Build dependency mirror: official, tencent, or aliyun.
MIRROR=official

# Versions installed into a newly built runtime image.
CODEX_VERSION=0.145.0
PLAYWRIGHT_MCP_VERSION=0.0.79
PLAYWRIGHT_VERSION=1.63.0-alpha-2026-08-05
