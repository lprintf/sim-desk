# Host-side paths. Relative paths are resolved from compose.yaml.
SIM_DESK_WORKSPACE=./workspace
SIM_DESK_OUTPUT=./data/output

# Nginx is the only published service. Use 127.0.0.1 when a same-host
# tunnel is the only client; use 0.0.0.0 for direct LAN access.
SIM_DESK_BIND_ADDRESS=0.0.0.0
SIM_DESK_PORT=8000

# Required. Generate a long random value before starting the stack.
SIM_DESK_AUTH_KEY=replace-with-a-long-random-value

# Optional Codex defaults for newly created threads.
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=on-request
CODEX_ACTIVITY_STALE_MS=600000

# Optional provider credentials. Keep real values only in .env or secrets.
MINIMAX_API_KEY=

# Build mirror selector. `official` uses the upstream registries. Set to
# `custom` together with the per-protocol URLs below for an internal mirror.
MIRROR=official
MIRROR_NPM_URL=
DEBIAN_APT_MIRROR=https://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR=https://deb.debian.org/debian-security
UBUNTU_APT_MIRROR=https://archive.ubuntu.com/ubuntu
UBUNTU_SECURITY_MIRROR=https://security.ubuntu.com/ubuntu
